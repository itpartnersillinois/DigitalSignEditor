@page
@model DigitalSignEditor.Pages.EditSingleModel
@{
}
<h1>Edit Sign</h1>
<div class="box">
<h2><span id="name"></span></h2>
    <div class="two-column">
        <div class="column">
            <p>Last Updated: <span id="lastupdated"></span></p>
            <p>College: <span id="college"></span></p>
            <p>Description: <span id="description"></span></p>
            <p>Twitter Feed: <span id="twitter"></span></p>
            <p>Sign Type: <span id="signtype"></span></p>
            <p>Only use slides that are applicable for your sign type. Contact IT Partners for more information.</p>
        </div>
        <div class="column">
            <p>Minimum Height for Images: <span id="minimumheight"></span></p>
            <p>Minimum Width for Images: <span id="minimumwidth"></span></p>
            <p>Maximum File Size: <span id="maximumsize"></span></p>
            <p>Image Ratio: <span id="ratio"></span></p>
            <p>Note that images that do not meet these requirements will not be accepted. If an image is not getting uploaded, confirm it meets the minimum size and aspect ratio.</p>
        </div>
    </div>
</div>
<span id="slideId" style="display: none;"></span>
<h2>Current Slides</h2>
<ol id="slides">
</ol>

<h2>Add New Slides</h2>
<div class="new">
    <label for="image-upload" class="hidden">Choose an image to upload</label>
<input type="file" id="image-upload" name="image-upload" multiple accept="image/*" onchange="return addpicture();" >
<button class="il-button" id="addImage" onclick="return picture();" disabled>Add an Image Slide</button>
</div>
<div class="new">
<button class="il-button" id="addWeather" onclick="return weather();">Add a Weather Slide</button>
</div>
<div class="new">
    <label for="videourl">Video URL: </label>
    <input type="text" id="videourl" name="videourl" onchange="return addvideo();" >
    <label for="videoseconds">Seconds to play: </label>
    <input type="text" id="videoseconds" name="videoseconds" class="seconds" onchange="return addvideo();" >
    <button class="il-button" id="addVideo" onclick="return video();" disabled>Add a Video Slide</button>
</div>
<div class="new">
    <label for="calendartitle">Calendar Title: </label>
    <input type="text" id="calendartitle" name="calendartitle"  onchange="return addcalendar();">
    <label for="calendarid">Calendar ID: </label>
    <input type="text" id="calendarid" name="calendarid" class="seconds"  onchange="return addcalendar();">
    <button class="il-button" id="addCalendar" onclick="return calendar();" disabled>Add a Calendar Slide</button>
</div>

@section Scripts
{
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function (event) {
        loadItems();
    });

    function loadItems() {
        const urlParams = new URLSearchParams(window.location.search);
        const id = urlParams.get('id');
        fetch('/Api/Sign/Get/' + id, {
            method: 'GET',
            headers: {
                "Content-type": "application/x-www-form-urlencoded; charset=UTF-8"
            }
        }).then(res => res.json()).then(data => {
            document.getElementById('slideId').innerText = id;
            document.getElementById('name').innerHTML = data.name;
            document.getElementById('college').innerText = data.college;
            document.getElementById('description').innerText = data.description;
            document.getElementById('twitter').innerText = data.twitter;
            document.getElementById('signtype').innerText = data.signType;
            document.getElementById('lastupdated').innerText = data.lastUpdated;
            document.getElementById('ratio').innerText = data.ratio;
            document.getElementById('minimumheight').innerText = data.minimumHeight;
            document.getElementById('minimumwidth').innerText = data.minimumWidth;
            document.getElementById('maximumsize').innerText = data.maximumSize;
            let slides = document.getElementById('slides');
            slides.innerHTML = '';
            data.items.forEach(element => {
                const li = document.createElement('li');
                const divFlex = document.createElement('div');
                divFlex.className = 'flex';
                const divName = document.createElement('div');
                divName.innerHTML = `<label for='name${element.id}' class='hidden'>Name </label><input id='name${element.id}' value='${element.name}' />`;
                divName.innerHTML += `<br /><label for='isactive${element.id}'>Is Active? </label><input id='isactive${element.id}' type='checkbox'' value='true' ${element.isActive ? 'checked' : ''}/>`
                const divData = document.createElement('div');
                divData.className = 'data';
                if (element.signOption == 0) {
                    divData.innerHTML = `<a href="${element.url}" target="_blank"><img src="${element.url}" alt=""></a>`
                }
                if (element.signOption == 1) {
                    divData.innerHTML = `Weather`
                }
                if (element.signOption == 2) {
                    divData.innerHTML = `<a href="${element.url}" target="_blank">Video</a>`
                }
                if (element.signOption == 3) {
                    divData.innerHTML = `Calendar`
                }
                const divDates = document.createElement('div');
                divDates.innerHTML = `<label for='from${element.id}'>From </label><input id='from${element.id}' value='${element.startDate}' class='date' /> <br /><label for='to{element.id}'>To</label> <input id='to${element.id}' value='${element.endDate}' class='date' />`
                const divButtons = document.createElement('div');
                divButtons.innerHTML = `<button class='il-button narrow' onclick='return edit(${element.id});'>Save</button> <button class='il-button narrow' onclick='return moveup(${element.id});'><div class="il-icon rotate">back</div></button> <button class='il-button narrow' onclick='return movedown(${element.id});'><div class="il-icon rotate">next</div></button> <button class='il-button narrow' onclick='return remove(${element.id});'>Remove</button>`

                divFlex.appendChild(divName);
                divFlex.appendChild(divData);
                divFlex.appendChild(divDates);
                divFlex.appendChild(divButtons);

                li.appendChild(divFlex);
                const divDescription = document.createElement('div');
                divDescription.innerHTML = `<label for='description${element.id}' class='hidden'>Description </label><input id='description${element.id}' value='${element.description}' />`
                divDescription.className = 'description';
                li.appendChild(divDescription);
                slides.appendChild(li);
            });
        });
    }

    function addpicture() {
        if (document.getElementById('image-upload').files.length > 0) {
            document.getElementById('addImage').removeAttribute('disabled');
        } else {
            document.getElementById('addImage').setAttribute('disabled', true);
        }
        return true;
    }

    function picture() {
        document.getElementById('addImage').setAttribute('disabled', true);
        for (let i = 0; i < document.getElementById('image-upload').files.length; i++) {
            var fd = new FormData();
            var file_data = document.getElementById('image-upload').files[i];
            fd.append('file', file_data);
            fd.append('id', document.getElementById('slideId').innerText);
            fetch('/Api/Image/Add', {
                method: 'POST',
                body: fd
            }).then(function (response) {
                return response.text().then(function (text) {
                    if (text.startsWith("Error")) {
                        document.getElementById('image-error').innerHTML = text;
                    } else {
                        loadItems();
                    }
                });
            });
        }
    }
    
    function edit(id) {
        let object = {};
        object['id'] = id;
        object['name'] = document.getElementById('name' + id).value;
        object['startDate'] = document.getElementById('from' + id).value;
        object['endDate'] = document.getElementById('to' + id).value;
        object['description'] = document.getElementById('description' + id).value;
        object['isActive'] = document.getElementById('isactive' + id).checked;
        var json = JSON.stringify(object);

        fetch('/Api/SignItem/Update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: json
        }).then(function (response) {
            return response.text().then(function (text) {
                loadItems();
            });
        });
    }
    
    function remove(id) {
        if (confirm('Are you sure you want to remove this?')) {
        fetch('/Api/SignItem/Remove/' + id, {
            method: 'POST'
        }).then(function (response) {
            return response.text().then(function (text) {
                loadItems();
            });
        });
        }
    }

    function moveup(id) {
        fetch('/Api/SignItem/Move/' + id + '/up', {
            method: 'POST'
        }).then(function (response) {
            return response.text().then(function (text) {
                loadItems();
            });
        });
    }

    function movedown(id) {
        fetch('/Api/SignItem/Move/' + id + '/down', {
            method: 'POST'
        }).then(function (response) {
            return response.text().then(function (text) {
                loadItems();
            });
        });
    }

    function weather() {
        let object = {};
        object['signId'] = document.getElementById('slideId').innerText;
        object['name'] = 'Weather Slide';
        object['data'] = '';
        object['option'] = 1;
        var json = JSON.stringify(object);

        fetch('/Api/SignItem/Add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: json
        }).then(function (response) {
            return response.text().then(function (text) {
                loadItems();
            });
        });
    }

    function addcalendar() {
        if (document.getElementById('calendartitle').value != '' && document.getElementById('calendarid').value) {
            document.getElementById('addCalendar').removeAttribute('disabled');
        } else {
            document.getElementById('addCalendar').setAttribute('disabled', true);
        }
        return true;
    }

    function calendar() {
        let object = {};
        object['signId'] = document.getElementById('slideId').innerText;
        object['name'] = document.getElementById('calendartitle').value;
        object['data'] = document.getElementById('calendarid').value;
        object['option'] = 3;
        var json = JSON.stringify(object);

        fetch('/Api/SignItem/Add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: json
        }).then(function (response) {
            return response.text().then(function (text) {
                loadItems();
            });
        });
    }

    function addvideo() {
        if (document.getElementById('videourl').value != '' && document.getElementById('videoseconds').value) {
            document.getElementById('addVideo').removeAttribute('disabled');
        } else {
            document.getElementById('addVideo').setAttribute('disabled', true);
        }
        return true;
    }

    function video() {
        let object = {};
        object['signId'] = document.getElementById('slideId').innerText;
        object['name'] = 'Video Slide';
        object['data'] = document.getElementById('videourl').value + ';' + document.getElementById('videoseconds').value;
        object['option'] = 2;
        var json = JSON.stringify(object);

        fetch('/Api/SignItem/Add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: json
        }).then(function (response) {
            return response.text().then(function (text) {
                loadItems();
            });
        });
    }
</script>
}