<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Digital Sign Editor | UIUC</title>
    <link rel="icon" href="https://cdn.brand.illinois.edu/favicon.ico">
    <link type="text/css" rel="stylesheet" href="https://cdn.brand.illinois.edu/toolkit/2/toolkit.css">
    <link type="text/css" rel="stylesheet" href="https://cdn.brand.illinois.edu/toolkit/2/icons.css">
    <script src="https://cdn.brand.illinois.edu/toolkit/2/toolkit.js"></script>
    <script src="//contrib.webtheme.illinois.edu/ils-input/input.min.js"></script>
    <link rel="stylesheet" href="//contrib.webtheme.illinois.edu/ils-input/input.min.css" media="all">
    <link type="text/css" rel="stylesheet" href="css/site.css">
    <script src="https://cdn.disability.illinois.edu/skipto.min.js"></script>
    <script>var SkipToConfig = { 'settings': { 'skipTo': { colorTheme: 'illinois' } } };</script>
    <script>
        document.addEventListener('DOMContentLoaded', function (event) {
            fetch('/Api/Security/IsAdmin', {
                method: 'GET',
                headers: {
                    "Content-type": "application/x-www-form-urlencoded; charset=UTF-8"
                }
            }).then(function (response) {
                return response.text().then(function (val) {
                    if (val && val === 'true') {
                        document.getElementById('menu-properties').classList.remove('hide');
                    }
                });
            });
            fetch('/api/donor/Permission', {
                method: 'GET',
                headers: {
                    "Content-type": "application/x-www-form-urlencoded; charset=UTF-8"
                }
            }).then(function (response) {
                return response.text().then(function (val) {
                    if (val && val === 'true') {
                        document.getElementById('menu-donors').classList.remove('hide');
                    }
                });
            });
        });
    </script>
</head>
<body>
    <header>
        <il-header>
            <div slot="wordmark">
                <il-unit-wordmark>
                    <p class="il-primary-unit"><a href="https://education.illinois.edu">IT Partners </a></p>
                    <h1><a href="/">Digital Sign Editor</a></h1>
                </il-unit-wordmark>
            </div>
            <div slot="search">
                <partial name="_LoginPartial" />
            </div>
            <il-nav slot="navigation"> 
                <il-nav-link>
                    <a href="/" target="_self">Home</a>
                </il-nav-link>
                <il-nav-link>
                    <a href="/view" target="_self">View All Signs</a>
                </il-nav-link>
                <il-nav-link>
                    <a href="/queue" target="_self">View Queue</a>
                </il-nav-link>
                <il-nav-link>
                    <a href="/edit" target="_self">Sign Editor</a>
                </il-nav-link>
                <il-nav-link id="menu-properties" class="hide">
                    <a href="/editproperties" target="_self">Sign Properties Editor</a>
                </il-nav-link>
                <il-nav-link id="menu-donors" class="hide">
                    <a href="/editdonors" target="_self">Education Donor Editor</a>
                </il-nav-link>
            </il-nav>
        </il-header>
    </header>
    <main role="main" class="il-formatted">
        @RenderBody()
    </main>
    <footer>
        <il-footer>    
            <nav slot="links" class="il-footer-links">
            <h2 class="il-invisible">Additional links</h2>
            <ul>
            <li><button id="ot-sdk-btn" class="ot-sdk-show-settings">Cookie Settings</button></li>
            <li><a href="https://www.vpaa.uillinois.edu/resources/web_privacy">Privacy Policy</a></li>
            <li><a href="https://itaccessibility.illinois.edu/contact">Accessibility</a></li>
            </ul>
            </nav>
        </il-footer>
    </footer>
    @RenderSection("Scripts", required: false)
</body>
</html>
