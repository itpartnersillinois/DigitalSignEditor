@page
@model DigitalSignEditor.Pages.EditModel
@{
}
<h1>Edit Signs</h1>
<div class="box">
<div class="two-column">
    <div class="column">
        <h2>Sign List</h2>
        <ul id="signs">
        </ul>
    </div>
    <div class="column">
        <h2>Transfer Changes</h2>
        <p>The digital sign processor pulls changes daily.<br /> You can trigger this manually using the button below.</p>
        <p><button class="il-button il-theme-orange" id="save" onclick="return save();">Transfer Changes</button></p>
    </div>
</div>
</div>
@section Scripts
{
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function (event) {
        loadItems();
    });

    function loadItems() {
        fetch('/Api/Sign/Get', {
            method: 'GET',
            headers: {
                "Content-type": "application/x-www-form-urlencoded; charset=UTF-8"
            }
        }).then(res => res.json()).then(data => {
            let signs = document.getElementById('signs');
            signs.innerHTML = '';
            data.items.forEach(element => {
                const li = document.createElement('li');
                const a = document.createElement('a');
                const div = document.createElement('div');
                a.innerHTML = element.name;
                a.setAttribute('href', '/editsingle?id=' + element.id);
                div.innerHTML = `${element.college} - ${element.description}`
                li.appendChild(a);
                li.appendChild(div);
                signs.appendChild(li);
            });
        });
    }

    function save() {
        alert('at this point, we would transfer files -- this is not implemented yet');
    }

</script>
}