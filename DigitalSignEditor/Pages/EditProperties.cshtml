@page
@model DigitalSignEditor.Pages.EditPropertiesModel
@{
}
<h1>Edit Properties</h1>
<p id="properties-noaccess">Contact a sign administrator to update the sign properties.</p>

<div class="box box-orange hide" id="properties-details">
<div class="two-column">
    <div class="column">
        <h2>Edit Sign</h2>
        <div id="signs"></div>
    </div>
    <div class="column">
        <h2>Administration</h2>
        <p><a class="il-button" href="/AddSign" id="addsignbutton">Add Sign</a></p>
        <p><a class="il-button" href="#" onclick="return getPermissions();" id="getpermissionss">Get Permissions Sheet</a></p>
    </div>
</div>
</div>
@section Scripts
{
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function (event) {
        loadItems();
    });

    function loadItems() {
        fetch('/Api/Security/IsAdmin', {
            method: 'GET',
            headers: {
                "Content-type": "application/x-www-form-urlencoded; charset=UTF-8"
            }
        }).then(function (response) {
            return response.text().then(function (val) {
                if (val && val === 'true') {
                    document.getElementById('properties-details').classList.remove('hide');
                    document.getElementById('properties-noaccess').classList.add('hide');
                }
            });
        });

        fetch('/Api/Sign/Get', {
            method: 'GET',
            headers: {
                "Content-type": "application/x-www-form-urlencoded; charset=UTF-8"
            }
        }).then(res => res.json()).then(data => {
            let signs = document.getElementById('signs');
            signs.innerHTML = '';
            data.forEach(college => {
                const h3 = document.createElement('h3');
                h3.innerHTML = college.collegeName;
                signs.appendChild(h3);
                const ul = document.createElement('ul');
                college.items.forEach(element => {
                    const li = document.createElement('li');
                    const a = document.createElement('a');
                    const div = document.createElement('div');
                    a.innerHTML = element.name;
                    a.setAttribute('href', '/properties?id=' + element.id);
                    div.innerHTML = element.description;
                    li.appendChild(a);
                    li.appendChild(div);
                    ul.appendChild(li);
                });
                signs.appendChild(ul);
            });
        });
    }

    function getPermissions() {
        fetch('/Api/Security/GetPermissions', {
            method: 'GET',
            headers: {
                "Content-type": "application/x-www-form-urlencoded; charset=UTF-8"
            }
        }).then(res => res.json()).then(data => {
            let str = '';
            data.forEach(element => {
                    str = str + element.college + ',' + element.signName + ',' + element.name + '\r\n';
            });
            window.open("data:text/csv;charset=utf-8," + escape(str));
        });
        return false;
    }
</script>
}