@page
@model DigitalSignEditor.Pages.EditPropertiesModel
@{
}
<h1>Edit Properties</h1>
<p id="properties-noaccess">Contact a sign administrator to update the sign properties.</p>

<div class="box box-orange hide" id="properties-details">
<div class="two-column">
    <div class="column">
        <h2>Edit Sign</h2>
        <ul id="signs">
        </ul>
    </div>
    <div class="column">
        <h2>Add New Sign</h2>
        <p><a class="il-button" href="/AddSign" id="addsignbutton">Add Sign</a></p>
    </div>
</div>
</div>
@section Scripts
{
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function (event) {
        loadItems();
    });

    function loadItems() {
        fetch('/Api/Security/IsAdmin', {
            method: 'GET',
            headers: {
                "Content-type": "application/x-www-form-urlencoded; charset=UTF-8"
            }
        }).then(function (response) {
            return response.text().then(function (val) {
                if (val && val === 'true') {
                    document.getElementById('properties-details').classList.remove('hide');
                    document.getElementById('properties-noaccess').classList.add('hide');
                }
            });
        });

        fetch('/Api/Sign/Get', {
            method: 'GET',
            headers: {
                "Content-type": "application/x-www-form-urlencoded; charset=UTF-8"
            }
        }).then(res => res.json()).then(data => {
            let signs = document.getElementById('signs');
            signs.innerHTML = '';
            data.items.forEach(element => {
                const li = document.createElement('li');
                const a = document.createElement('a');
                const div = document.createElement('div');
                a.innerHTML = element.name;
                a.setAttribute('href', '/properties?id=' + element.id);
                div.innerHTML = `${element.college} - ${element.description}`
                li.appendChild(a);
                li.appendChild(div);
                signs.appendChild(li);
            });
        });
    }
</script>
}