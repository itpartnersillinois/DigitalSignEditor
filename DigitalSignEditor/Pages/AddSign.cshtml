@page
@model DigitalSignEditor.Pages.AddSignModel
@{
    ViewData["Title"] = "Add New Sign";
}
<h1>Add New Sign</h1>
<p>Note that all fields must be filled out, and this information (except the name) cannot be changed after submission.</p>
<div id="edit-properties">
    <div class="ils-input-entry">
        <label for="signtype">Sign Type ID:</label><select id="signtype" required>
        <option value="">Choose one</option>
        <option value="0">Lobby (has title, time)</option>
        <option value="1">Simple (picture only)</option>
        <option value="2">SimpleWithTitle (has title)</option>
    </select></div>
    <div class="ils-input-entry">
        <label for="college">College ID:</label><select id="college" required>
        <option value="">Choose one</option>
        <option value="0">College_of_Education</option>
        <option value="1">Gies_College_of_Business</option>
        <option value="2">College_of_Education_CRC</option>
        <option value="3">Swanlund</option>
         </select>
    </div>
    <div class="ils-input-entry"><label for="name">Name:</label> <input type="text" id="name" class="ils-input-long" required /></div>
    <div class="ils-input-entry"><label for="url">Url:</label> <input type="text" id="url" class="ils-input-long" required /></div>
</div>

<button class="il-button" id="update" onclick="return update();">Add Sign</button>

<div class="box">
    <h2>SignType</h2>
    <p>Lobby, Simple, SimpleWithTitle</p>
    <h2>College Type</h2>
    <p>College_of_Education, Gies_College_of_Business, College_of_Education_CRC, Swanlund</p>
</div>

@section Scripts
{
<script type="text/javascript">
    function update() {
        if (document.getElementById('name').value == '' ||
            document.getElementById('url').value == '' ||
            document.getElementById('signtype').value == '' ||
            document.getElementById('college').value == '') {
                alert('Note that all fields need to be completed');
        } else {
            let object = {};
            object['name'] = document.getElementById('name').value;
            object['url'] = document.getElementById('url').value;
            object['signtype'] = document.getElementById('signtype').value;
            object['college'] = document.getElementById('college').value;
            var json = JSON.stringify(object);

            fetch('/Api/Sign/Add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: json
            }).then(res => res.json()).then(data => {
                window.location.href = '/properties?id=' + data;
            });
        }
    }
</script>
}