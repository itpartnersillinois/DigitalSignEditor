@page
@model DigitalSignEditor.Pages.AddSignModel
@{
}

<h1>Add Sign</h1>
<p>Note that all fields must be filled out, and this information cannot be changed after submission.</p>
<div id="edit-properties">
    <p><label for="signtype">Sign Type ID:</label> <select id="signtype">
        <option value="">Choose one</option>
        <option value="0">Lobby</option>
        <option value="1">Simple</option>
        <option value="2">SimpleWithTitle</option>
    </select></p>
    <p><label for="college">College ID:</label> <select id="college">
        <option value="">Choose one</option>
        <option value="0">College_of_Education</option>
        <option value="1">Gies_College_of_Business</option>
        <option value="2">College_of_Education_CRC</option>
    </select></p>
    <p><label for="name">Name:</label> <input type="text" id="name" /></p>
    <p><label for="description">Description:</label> <input type="text" id="description" /></p>
    <p><label for="url">Url:</label> <input type="text" id="url" /></p>
</div>

<button class="il-button" id="update" onclick="return update();">Add Sign</button>

<div class="box">
    <h2>SignType</h2>
    <p>Lobby, Simple, SimpleWithTitle</p>
    <h2>College Type</h2>
    <p>College_of_Education, Gies_College_of_Business, College_of_Education_CRC</p>
</div>

@section Scripts
{
<script type="text/javascript">
    function update() {
        if (document.getElementById('name').value == '' ||
            document.getElementById('url').value == '' ||
            document.getElementById('signtype').value == '' ||
            document.getElementById('college').value == '') {
                alert('Note that all fields except description need to be completed');
        } else {
            let object = {};
            object['name'] = document.getElementById('name').value;
            object['description'] = document.getElementById('description').value;
            object['url'] = document.getElementById('url').value;
            object['signtype'] = document.getElementById('signtype').value;
            object['college'] = document.getElementById('college').value;
            var json = JSON.stringify(object);

            fetch('/Api/Sign/Add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: json
            }).then(res => res.json()).then(data => {
                window.location.href = '/properties?id=' + data;
            });
        }
    }
</script>
}