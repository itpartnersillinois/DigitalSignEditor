@page
@model DigitalSignEditor.Pages.ViewModel
@{
}

<h1>Sign List</h1>
<div id="signs">

</div>

@section Scripts
{
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function (event) {
        loadItems();
    });

    function loadItems() {
        fetch('/Api/Sign/GetAll', {
            method: 'GET',
            headers: {
                "Content-type": "application/x-www-form-urlencoded; charset=UTF-8"
            }
        }).then(res => res.json()).then(data => {
            let signs = document.getElementById('signs');
            signs.innerHTML = '';
            data.forEach(college => {
                const h2 = document.createElement('h2');
                h2.innerHTML = college.collegeName;
                signs.appendChild(h2);
                const ul = document.createElement('ul');
                college.items.forEach(element => {
                    const li = document.createElement('li');
                    li.innerHTML = `<p><a href='https://digitalsign2.education.illinois.edu/${element.url}/index.html' target='_blank'>${element.name}</a><br>${element.description}</p>`;
                    ul.appendChild(li);
                });
                signs.appendChild(ul);
            })
        });
    }
</script>
}